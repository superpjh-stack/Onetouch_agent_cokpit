# Copy needed values into the root .env. Never put API keys in web code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
COCKPIT_ACCESS_TOKEN=
# Optional: existing PostgreSQL adapter. Empty uses the existing SQLite demo.
DATABASE_URL=
# ONETOUCH_DB_PATH=data/onetouch_demo.db
